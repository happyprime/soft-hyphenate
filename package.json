{
	"name": "soft-hyphenate",
	"version": "1.0.0",
	"private": true,
	"description": "Development tooling for the Soft Hyphenate WordPress plugin.",
	"author": "Happy Prime",
	"license": "GPL-2.0-or-later",
	"keywords": [
		"wordpress",
		"wordpress-plugin"
	],
	"homepage": "https://github.com/happyprime/soft-hyphenate/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/happyprime/soft-hyphenate.git"
	},
	"bugs": {
		"url": "https://github.com/happyprime/soft-hyphenate/issues"
	},
	"engines": {
		"node": ">=20"
	},
	"devDependencies": {
		"@wordpress/env": "^11.17.0",
		"@wordpress/npm-package-json-lint-config": "^5.57.0",
		"npm-package-json-lint": "^11.0.0"
	},
	"scripts": {
		"env:start": "composer install && wp-env start && npm run env:seed",
		"env:seed": "wp-env run cli --env-cwd=wp-content/plugins/soft-hyphenate wp eval-file .dev/seed.php",
		"env:stop": "wp-env stop",
		"env:destroy": "wp-env destroy",
		"env:cli": "wp-env run cli",
		"env:logs": "wp-env logs",
		"env:test:start": "composer install && wp-env start --config .wp-env.tests.json",
		"env:test:stop": "wp-env stop --config .wp-env.tests.json",
		"env:test:destroy": "wp-env destroy --config .wp-env.tests.json",
		"test:php": "wp-env run cli --config .wp-env.tests.json --env-cwd=wp-content/plugins/soft-hyphenate vendor/bin/phpunit",
		"lint:package": "node ./node_modules/npm-package-json-lint/dist/cli.js ./package.json"
	}
}
